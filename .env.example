# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both values are public. The anon key is meant to ship in the browser bundle;
# every table it can reach is protected by row-level security.
# Never put the service_role key in a VITE_ variable — Vite inlines those
# into the client bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the GraphQL API lives. Left unset, it defaults to
# http://localhost:4000/ — correct for local dev against `npm run dev:api`.
#
# On Vercel, with the API deployed as api/graphql.ts in this same project,
# set this to the relative path below in the Vercel dashboard. A relative
# path means it resolves against whatever domain serves the page, so the
# same value works for production and every preview deployment.
# VITE_GRAPHQL_URL=/api/graphql

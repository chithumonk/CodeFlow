# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both values are public. The anon key is meant to ship in the browser bundle;
# every table it can reach is protected by row-level security.
# Never put the service_role key in a VITE_ variable — Vite inlines those
# into the client bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

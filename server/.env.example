# Backend environment. Copy to server/.env — never commit the real file.
#
# These are SEPARATE from the frontend's VITE_ variables. Nothing here is
# inlined into a browser bundle, so this is the only place a secret may live.

PORT=4000

# Same project as the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable/anon key. The server deliberately uses this, not the
# service-role key: every request is made with the caller's own JWT so
# PostgreSQL row-level security still applies. A service-role key would
# bypass RLS and make the API the only thing standing between one user's
# data and another's.
SUPABASE_ANON_KEY=sb_publishable_xxx

# Where the frontend runs, for CORS.
CORS_ORIGIN=http://localhost:5173

# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# --- Running the languages CodeFlow cannot trace ---------------------------
#
# JavaScript, TypeScript, Python and Ruby run in the browser and never reach
# this server. Everything else is compiled or run by an execution service.
#
# "judge0" — the public instance needs no key and covers the compiled
#            languages (Java, C, C++, C#, Go, Rust, PHP, Kotlin, Swift, ...).
#            It is a shared public service: rate limited, and user code
#            leaves your infrastructure.
# "piston" — what a self-hosted runner usually is, and covers more languages.
#            The public instance at emkc.org became whitelist-only in
#            February 2026, so this is only useful pointed at your own:
#              docker run -d -p 2000:2000 --privileged \
#                ghcr.io/engineer-man/piston
#              EXECUTION_PROVIDER_URL=http://localhost:2000/api/v2
EXECUTION_PROVIDER=judge0
EXECUTION_PROVIDER_URL=https://ce.judge0.com

# Optional. Sent as X-Auth-Token (Judge0) or Bearer (Piston).
# EXECUTION_PROVIDER_TOKEN=

# Per-run CPU limit. The provider enforces it; the server waits 5s longer.
EXECUTION_TIMEOUT_MS=10000
